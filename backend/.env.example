# NexaCart Backend — Environment Variables
# Copy this file to .env and fill in your values
# Never commit .env to source control

# ── Database ──────────────────────────────────────────────────────────────────
# PostgreSQL connection string
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=SCHEMA
DATABASE_URL="postgresql://postgres:YOUR_PASSWORD@localhost:5432/nexacart?schema=public"

# Integration test database (optional, run tests against an isolated DB)
TEST_DATABASE_URL="postgresql://postgres:YOUR_PASSWORD@localhost:5432/nexacart_test?schema=public"

# ── Server ────────────────────────────────────────────────────────────────────
PORT=3000
NODE_ENV=development

# ── Authentication ────────────────────────────────────────────────────────────
# Use a long, random secret (minimum 16 characters)
JWT_SECRET="replace-this-with-a-long-random-secret"
JWT_EXPIRES_IN="1d"

# ── CORS ──────────────────────────────────────────────────────────────────────
# Frontend origin allowed for cross-origin requests
CORS_ORIGIN="http://localhost:4200"

# ── Refresh Tokens ────────────────────────────────────────────────────────────
# Number of days a refresh token remains valid (1–30)
REFRESH_TOKEN_TTL_DAYS=7

# ── Cart & Reservations (Phase 4) ──────────────────────────────────────────────
# Reservation TTL in minutes (1–1440, default 30)
CART_RESERVATION_TTL_MINUTES=30
# Maximum distinct items allowed per cart (1–200, default 50)
CART_MAX_DISTINCT_ITEMS=50
# Maximum quantity allowed per item (1–1000, default 100)
CART_MAX_ITEM_QUANTITY=100

# ── LLM Agent & Provider (Phase 7) ────────────────────────────────────────────
# Active LLM provider: 'openai' (default) or 'ollama' (for local inference)
LLM_PROVIDER=ollama

# OpenAI Configuration (required only when LLM_PROVIDER=openai)
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-4o"

# Ollama Local Configuration (required when LLM_PROVIDER=ollama)
# Base HTTP URL for local Ollama server (use host.docker.internal if running in Docker)
OLLAMA_BASE_URL=http://localhost:11434
# Installed model name pulled via `ollama pull qwen3.5:4b`
OLLAMA_MODEL=qwen3.5:4b
# Maximum timeout in milliseconds per single Ollama HTTP request (default 180000)
OLLAMA_REQUEST_TIMEOUT_MS=180000
# Initial context window size in tokens for Ollama (default 8192)
OLLAMA_NUM_CTX=8192

# Agent execution limits
# Built-in application default is 60000ms; 180000ms aligns total run budget with local Ollama request timeout
AGENT_RUN_TIMEOUT_MS=180000
AGENT_MAX_STEPS=10
AGENT_MAX_TOOL_CALLS=20
AGENT_MAX_INSTRUCTION_LENGTH=2000
